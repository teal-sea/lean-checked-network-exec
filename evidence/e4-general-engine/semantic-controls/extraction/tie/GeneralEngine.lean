          let a ← Array.update buf cur_len t
          let cur_len1 ← cur_len + 1#usize
          let remaining1 ← remaining - 1#usize
          ok (cont (a, cur_len1, remaining1, failed))
    else ok (done (buf, cur_len, failed))
  else ok (done (buf, cur_len, failed))

