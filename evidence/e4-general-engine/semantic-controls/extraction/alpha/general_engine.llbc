u >> 16) & 255;\n    let b1 = (u >> 8) & 255;\n    let b0 = u & 255;\n    let mut e = w.exp_n[n as usize];\n    e = (e * w.exp_2[b2 as usize]) >> EXP_FRAC_BITS;\n    e = (e * w.exp_1[b1 as usize]) >> EXP_FRAC_BITS;\n    e = (e * w.exp_0[b0 as usize]) >> EXP_FRAC_BITS;\n    e\n}","attr_info":{"attributes":[{"DocComment":" Integer stand-in for `2^30 * exp(-d / 2^32)`, for `d >= 0`."},{"DocComment":""},{"DocComment":" `d` is cut to 24 fractional bits, `u = d >> 8`, and split as"},{"DocComment":" `u = n * 2^24 + b2 * 2^16 + b1 * 2^8 + b0`. The result is the product of the four table"},{"DocComment":" entries `w.exp_n[n]`, `w.exp_2[b2]`, `w.exp_1[b1]`, `w.exp_0[b0]`, with a shift by 30"},{"DocComment":" after each multiplication. It is `2^30` at `d = 0` and `0` when `n >= 32`. A negative `d`"},{"DocComment":" does not occur in this program and gives `2^30`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown","late_bound":true}],"types":[],"const_generics":[],"trait_clauses":[],"outlives":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":97},{"Deduplicated":14}],"output":{"Deduplicated":14}},"src":"Normal","body":{"Structured":{"span":{"Value":[485,{"data":{"file_id":0,"beg":{"line":237,"col":0},"end":{"line":254,"col":1}},"generated_from_span":null}]},"bound_body_regions":2,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[486,{"data":{"file_id":0,"beg":{"line":237,"col":39},"end":{"line":237,"col":42}},"generated_from_span":null}]},"ty":{"Deduplicated":14},"drop_flag_for":null},{"index":1,"name":"w","span":{"Value":[487,{"data":{"file_id":0,"beg":{"line":237,"col":15},"end":{"line":237,"col":16}},"generated_from_span":null}]},"ty":{"Deduplicated":99},"drop