    Source: 'src/lib.rs', lines 237:0-254:1
    Visibility: public -/
def exp_fix (w : Weights) (d : Std.I64) : Result Std.I64 := do
  if d <= 0#i64
  then EXP_ONE
  else
    let u ← d >>> 8#i32
    let n ← u >>> 24#i32
    if n >= EXP_N_LEN
    then ok 0#i64
    else
      let i ← u >>> 16#i32
      let b2 ← lift (i &&& 255#i64)
      let i1 ← u >>> 8#i32
      let b1 ← lift (i1 &&& 255#i64)
      let b0 ← lift (u &&& 255#i64)
      let i2 ← lift (IScalar.hcast .Usize n)
      let e ← Array.index_usize w.exp_n i2
      let i3 ← lift (IScalar.hcast .Usize b2)
      let i4 ← Array.index_usize w.exp_2 i3
      let i5 ← e * i4
      let e1 ← i5 >>> EXP_FRAC_BITS
      let i6 ← lift (IScalar.hcast .Usize b1)
      let i7 ← Array.index_usize w.exp_1 i6
      let i8 ← e1 * i7
      let e2 ← i8 >>> EXP_FRAC_BITS
      let i9 ← lift (IScalar.hcast .Usize b0)
      let i10 ← Array.index_usize w.exp_0 i9
      let i11 ← e2 * i10
      i11 >>> EXP_FRAC_BITS

