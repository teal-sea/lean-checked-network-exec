def forward
  (weights : Weights) (a : Std.Usize) (b : Std.Usize) :
  Result (Array Std.I64 113#usize)
  := do
  let a1 ← embed weights a 0#usize
  let a2 ← embed weights b 1#usize
  let a3 ← embed weights EQ 2#usize
  let att ← attention weights (Array.make 3#usize [ a1, a2, a3 ])
  let a4 ← Array.index_usize (Array.make 3#usize [ a1, a2, a3 ]) 2#usize
  let r ← residual a4 att
  let m ← mlp_hidden weights r
  let o ← mlp_output weights m
  let fin ← final_stream r o
  unembed weights fin

