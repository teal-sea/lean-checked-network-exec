/-- [general_engine::forward_logits]:
    Source: 'src/lib.rs', lines 507:0-541:1
    Visibility: public -/
def forward_logits
  (w : Weights) (tokens : Array Std.Usize 32#usize) (seq_len : Std.Usize) :
  Result (Option (Array Std.I64 256#usize))
  := do
  if seq_len = 0#usize
  then ok none
  else
    if seq_len > MAX_SEQ
    then ok none
    else
      if w.n_layers = 0#usize
      then ok none
      else
        if w.n_layers > MAX_LAYERS
        then ok none
        else
          if w.vocab_size = 0#usize
          then ok none
          else
            if w.vocab_size > VOCAB
            then ok none
            else
              let tokens_ok ←
                forward_logits_loop0 tokens seq_len true 0#usize
              if tokens_ok
              then
                let x ← embed_all w tokens seq_len
                let last_hidden := Array.repeat 128#usize 0#i64
                let last_hidden1 ←
                  forward_logits_loop1 w.n_layers w.vocab_size w.tok 
                    w.pos w.layers w.u w.exp_n w.exp_2 w.exp_1 w.exp_0 seq_len
                    x last_hidden 0#usize
                let a ← unembed w last_hidden1
                ok (some a)
              else ok none

