  simp only [pos, TransformerInt.Gen.pos, Array.from_val, List.map_cons, List.map_nil, pos_0_view, pos_1_view, pos_2_view]

theorem pos_bound : MatrixBound 59 pos := by
  intro r hr
  simp only [pos, Array.from_val, List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl
  · exact pos_0_bound
  · exact pos_1_bound
  · exact pos_2_bound

end LcnExec.Engine.TrainedData
