@loop.spec_decr_nat : ∀ {α : Type u_1} {β : Type u_2} (measure : α → ℕ) (inv : α → Prop) (post : β → Prop)
  (body : α → Result (ControlFlow α β)) (x : α),
  (∀ (x : α),
      inv x →
        body x ⦃ r =>
          match r with
