def generate_greedy_loop.body
  (w : Weights) (buf : Array Std.Usize 32#usize) (cur_len : Std.Usize)
  (remaining : Std.Usize) (failed : Bool) :
  Result (ControlFlow ((Array Std.Usize 32#usize) × Std.Usize × Std.Usize ×
    Bool) ((Array Std.Usize 32#usize) × Std.Usize × Bool))
  := do
