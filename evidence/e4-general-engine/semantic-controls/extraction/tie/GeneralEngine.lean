def predict_next
  (w : Weights) (tokens : Array Std.Usize 32#usize) (seq_len : Std.Usize) :
  Result (Option Std.Usize)
  := do
  let lg ← forward_logits w tokens seq_len
  match lg with
  | none => ok none
  | some l => let i ← argmax l w.vocab_size
              ok (some i)

